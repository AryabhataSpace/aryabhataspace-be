# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aryabhataspace_db
DB_SSL=false
DB_LOGGING=false
DB_MIGRATIONS_RUN=true

# JWT Authentication
JWT_SECRET=aryabhata_space_jwt_secret_key_2026_production
JWT_EXPIRES_IN=7d

# Gmail SMTP Configuration (Nodemailer)
GMAIL_USER=aryabhataspace.org@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
GMAIL_FROM="Aryabhata Space Platform" <no-reply@aryabhataspace.org>

# Application Base URL (for email verification & password reset links)
APP_URL=http://localhost:3000

# Server Port
PORT=3000

# Angular SSR Allowed Hosts
NG_ALLOWED_HOSTS=*
