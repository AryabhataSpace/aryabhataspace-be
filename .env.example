# =============================================================================
# Aryabhata Space - Backend Environment Configuration (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_NAME="Aryabhata Space Backend"
APP_URL=http://localhost:3000

# Global API route prefix (all endpoints are grouped under /api/v1)
API_PREFIX=api/v1

# Allowed origins for Cross-Origin Resource Sharing (CORS)
# Use comma-separated list for multiple origins in development/staging
CORS_ORIGIN=http://localhost:4200

# Angular SSR allowed hosts header configuration (prevents SSRF warnings)
NG_ALLOWED_HOSTS=*


# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL & TypeORM)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=aryabhataspace_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Full PostgreSQL Connection URL (used by cloud platforms like Railway/Supabase/Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aryabhataspace_db


# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT & Session)
# -----------------------------------------------------------------------------
JWT_SECRET=aryabhata_space_dev_jwt_secret_key_change_in_production_2026!
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=aryabhata_space_dev_jwt_refresh_secret_key_change_in_production_2026!
JWT_REFRESH_EXPIRES_IN=30d


# -----------------------------------------------------------------------------
# 4. FILE & DOCUMENT UPLOADS (Candidate Resumes, Reports, Verification)
# -----------------------------------------------------------------------------
UPLOAD_DESTINATION=./uploads
# Max upload file size in bytes (10MB default)
MAX_FILE_SIZE_BYTES=10485760


# -----------------------------------------------------------------------------
# 5. NOTIFICATIONS & EMAIL SERVICE (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Aryabhata Space <no-reply@aryabhataspace.org>"
